---
extends: default

rules:
  braces:
    max-spaces-inside: 1
  line-length:
    max: 160
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    check-keys: false

ignore:
  - .github/
  # byte-exact rendering fixture, compared verbatim
  - molecule/airgap/files/config-server-1.8.1.yaml
