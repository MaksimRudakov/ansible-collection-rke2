apiVersion: v1
kind: Secret
metadata:
  name: {{ fleet_gitrepo_secret_name }}
  namespace: {{ fleet_gitrepo_namespace }}
type: kubernetes.io/basic-auth
# data, not stringData: stringData is write-only, so kubectl apply reports
# "configured" on every run and the task is never idempotent
data:
  username: {{ fleet_gitrepo_username | b64encode }}
  password: {{ fleet_gitrepo_token | b64encode }}
